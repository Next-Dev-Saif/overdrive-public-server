datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String    @id @default(uuid())
  username     String    @unique
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  lastLogin    DateTime?
  
  stats        PlayerStats?
  wallet       Wallet?
  vehicles     VehicleInventory[]
  weapons      WeaponInventory[]
}

model PlayerStats {
  id           String    @id @default(uuid())
  userId       String    @unique
  level        Int       @default(1)
  xp           Int       @default(0)
  mmr          Int       @default(1000)
  totalMatches Int       @default(0)
  wins         Int       @default(0)
  kills        Int       @default(0)
  deaths       Int       @default(0)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wallet {
  id           String    @id @default(uuid())
  userId       String    @unique
  scrap        Int       @default(0)
  credits      Int       @default(0)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VehicleInventory {
  id           String    @id @default(uuid())
  userId       String
  vehicleType  String    // e.g. "juggernaut"
  color        String?
  engineLevel  Int       @default(1)
  armorLevel   Int       @default(1)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeaponInventory {
  id           String    @id @default(uuid())
  userId       String
  weaponType   String    // e.g. "minigun"
  damageLevel  Int       @default(1)
  cooldownLevel Int      @default(1)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
