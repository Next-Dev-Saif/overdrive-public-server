NODE_ENV=production
PORT=3001
HOST=0.0.0.0
FRONTEND_ORIGINS=https://your-site.netlify.app
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Mount persistent storage at /data and make it writable by the server user.
DATABASE_URL=file:/data/overdrive.db
# Set to the exact trusted reverse-proxy hop count supplied by Blitz; never blindly use true.
TRUST_PROXY_HOPS=0
